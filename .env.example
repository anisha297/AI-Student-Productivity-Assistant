# Backend API URL (optional override; defaults dynamically to host IP on port 8000)
# Example for local development:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Or for physical mobile devices on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000/api

# Google OAuth 2.0 Client IDs
# Web Client ID (Used for web browser, Expo Web, and server-side authorization code verification)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android Client ID (Google Cloud Console OAuth 2.0 Client ID for Android)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# iOS Client ID (Google Cloud Console OAuth 2.0 Client ID for iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
